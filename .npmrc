# Dependency cooldown: npm resolves only versions published at least 7 days ago (npm 11.10+).
# It applies where npm resolves new versions (`npm install <pkg>`, `npm update`); `npm ci`
# installs the lockfile as written. Older npm does not enforce it: 10.x ignores the key and
# 11.0-11.9 at most warns, so installs still pass there.
min-release-age=7
#
# Urgent security bump: exempt just that package (npm 11.17+), then commit the lockfile.
#   npm install <pkg>@<fixed-version> --min-release-age-exclude=<pkg>
# Or add `min-release-age-exclude[]=<pkg>` under the key above, and remove it after the bump.
